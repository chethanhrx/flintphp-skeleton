{
    "name": "flintphp/skeleton",
    "description": "The official application skeleton for the FlintPHP framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "flintphp/framework": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": {
    }
}
